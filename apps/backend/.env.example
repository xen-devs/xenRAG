DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5434/xenrag_db
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:admin@localhost:5434/xenrag_db

JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY=7

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

OLLAMA_URL=
LLM_MODEL=
LLM_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=reviews

# Graph Store (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# RAG Settings
RAG_RETRIEVAL_LIMIT=10

# LLM Strategy: failover, round_robin, least_connections, random
LLM_STRATEGY=failover

# Optional: Gemini Fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash